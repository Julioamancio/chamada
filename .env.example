# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" está no .gitignore e NÃO será commitado.

# --- Git/GitHub ---
GITHUB_USER=Julioamancio
GITHUB_REPO=Julioamancio/chamada
# Token classic com escopo repo (deixe vazio se usar SSH)
GITHUB_PAT=

# Para SSH, informe os caminhos das chaves locais (opcional)
SSH_KEY_PRIV=~/.ssh/id_ed25519
SSH_KEY_PUB=~/.ssh/id_ed25519.pub

# --- Render.com ---
SECRET_KEY=
CHAMADA_DATA_DIR=/opt/render/project/src/instance
BACKUP_INTERVAL_MIN=30
DATABASE_URL=

# --- Outras opções ---
GIT_REMOTE_ALIAS=origin
GIT_BRANCH=main
